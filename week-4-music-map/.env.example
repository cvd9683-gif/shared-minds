# Music Map — copy to .env.local and fill in. All values are optional:
# without them the prototype runs on fictional demo data and saves to this browser.
# These are public client identifiers, not secrets, but .env.local is git-ignored anyway.

# Spotify (https://developer.spotify.com/dashboard)
# Redirect URI to register: http://127.0.0.1:5173/
VITE_SPOTIFY_CLIENT_ID=

# Firebase Realtime Database (Project settings → Your apps → Web app config)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Genius (https://genius.com/api-clients → Generate Access Token). No VITE_ prefix:
# the dev server adds it to Genius requests, so it never ends up in the built site.
GENIUS_TOKEN=
